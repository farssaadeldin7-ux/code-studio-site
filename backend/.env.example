# ---- Server ----
PORT=4242
# Comma-separated list of origins allowed to call the checkout/portal endpoints.
# Include your marketing site and any plugin web surfaces. Use * only for local dev.
ALLOWED_ORIGINS=http://localhost:3000,https://farssaadeldin7-ux.github.io

# ---- Stripe ----
# Secret key from https://dashboard.stripe.com/apikeys (use sk_test_... while developing).
STRIPE_SECRET_KEY=sk_test_replace_me
# Webhook signing secret from the Stripe CLI (`stripe listen`) or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Price IDs for the plans you sell (create them in the Stripe Dashboard as recurring prices).
# The keys on the left (pro, team) are the plan slugs your plugin / pricing page passes to /api/checkout.
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_TEAM=price_replace_me

# ---- URLs ----
# Where Stripe sends the customer after checkout. {CHECKOUT_SESSION_ID} is substituted by Stripe.
CHECKOUT_SUCCESS_URL=https://farssaadeldin7-ux.github.io/code-studio-site/success.html?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://farssaadeldin7-ux.github.io/code-studio-site/#platforms
# Where the Stripe billing portal returns the customer.
PORTAL_RETURN_URL=https://farssaadeldin7-ux.github.io/code-studio-site/

# ---- Storage ----
# Path to the JSON data file (default: ./data/store.json). Swap lib/store.js for a real DB in production.
DATABASE_PATH=./data/store.json
